# Copia a .env en la raíz del repositorio. Para el ZIP, junto a serve.cjs.
# Nunca lo subas a Git ni lo copies a dist.
TMDB_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Correo público de este sitio. Cada comprador configura el suyo.
DMCA_EMAIL=
# Opcional: parrilla JSON verificada con canal, partido, competición y horarios.
# Sin esta fuente no se inventan partidos. Ver FUTBOL-TV.md.
FOOTBALL_GUIDE_URL=
